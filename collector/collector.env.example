# /etc/yamshopping/collector.env — נוצר ע"י setup.sh. לא נכנס ל-git!
SUPABASE_URL=https://ygyfodxfbebnkwdcbjrp.supabase.co
# מפתח השירות (secret / service_role). setup.sh מבקש להדביק אותו.
SUPABASE_SERVICE_KEY=
DATA_DIR=/var/lib/yamshopping
GIT_BRANCH=main
# כמה הורדות במקביל לכל רשת (2 בשרת של 1GB, 6 בשרת גדול)
THREADS=2
# כמה מוצרים לכל רשת עולים ל-Supabase כ"מחיר מייצג"
REP_LIMIT=4000
# כמה ימים לשמור היסטוריית שינויי מחיר
HISTORY_DAYS=60
# האתר רץ מ-Caddy בשרת הזה ולא מ-Vercel — לא סומכים על כותרות x-vercel-*. רק אם מחזירים את האתר ל-Vercel: TRUST_VERCEL=1
TRUST_VERCEL=0
